# Qwen3-TTS OpenAI-compatible Server — AMD ROCm
#
# Build:  docker build -f Dockerfile.rocm -t qwen3-tts-rocm .
# Run:    docker run --device /dev/kfd --device /dev/dri \
#           --group-add video --group-add render \
#           --security-opt seccomp=unconfined \
#           -p 8880:8880 -v ~/qwen3-tts:/root/qwen3-tts \
#           qwen3-tts-rocm

FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0

WORKDIR /opt/qwen3-tts

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 git \
    && rm -rf /var/lib/apt/lists/*

# uv — much faster resolver/installer than pip for the wheel-heavy steps below
RUN pip install --no-cache-dir uv

# Python dependencies.
# The ROCm torch stack is installed FIRST so nothing below can pull the
# CUDA wheels from PyPI (unpinned torch/torchaudio resolve to the CUDA
# build and would clobber the base image's ROCm torch). The base image
# already ships matching versions, so this is nearly a no-op; it also
# covers torchvision/torchaudio/triton explicitly.
RUN uv pip install --python /opt/venv/bin/python --no-cache --no-index \
    --find-links https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/ \
    torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 triton==3.6.0

COPY requirements.txt .
# requirements.txt keeps unpinned torch>=2.4.0 for the CUDA Dockerfile —
# skip torch* lines here (base image + pin above already provide them).
RUN grep -v '^torch' requirements.txt > /tmp/reqs-rocm.txt \
    && uv pip install --python /opt/venv/bin/python --no-cache -r /tmp/reqs-rocm.txt

# Install flash attention (AMD Triton path — built from source).
# --no-deps: the ROCm base image's triton dist-info is malformed and
# breaks uv's resolver; torch+triton are already present anyway.
RUN cd /tmp && \
    git clone https://github.com/Dao-AILab/flash-attention.git && \
    cd flash-attention && \
    FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE uv pip install --python /opt/venv/bin/python --no-cache --no-build-isolation --no-deps . && \
    cd / && rm -rf /tmp/flash-attention

# Copy application code (includes qwen_tts/ with streaming patches applied)
COPY . .

# Install the package (makes qwen_tts importable).
# --no-deps: every runtime dep is already covered by requirements.txt,
# the ROCm torch stack, or the gradio/faster-whisper step below. Letting
# the resolver see pyproject's loose torch-family constraints pulls the
# CUDA wheels from PyPI all over again.
RUN uv pip install --python /opt/venv/bin/python --no-cache --no-deps -e .

# Belt-and-suspenders: force the exact ROCm build if anything slipped through.
RUN uv pip install --python /opt/venv/bin/python --no-cache --no-index \
    --find-links https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.4/ \
    torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 triton==3.6.0

# Voice Studio (Gradio UI at /voice-studio) — local addition, not upstream
RUN uv pip install --python /opt/venv/bin/python --no-cache gradio faster-whisper

# Default config location
RUN mkdir -p /root/qwen3-tts/voice_library
COPY config.yaml /root/qwen3-tts/config.yaml

# AMD ROCm optimizations
ENV FLASH_ATTENTION_TRITON_AMD_ENABLE=TRUE \
    MIOPEN_FIND_MODE=FAST \
    TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1 \
    GPU_MAX_ALLOC_PERCENT=100 \
    GPU_MAX_HEAP_SIZE=100 \
    GPU_MAX_HW_QUEUES=1 \
    TTS_BACKEND=optimized \
    HOST=0.0.0.0 \
    PORT=8880 \
    WORKERS=1

EXPOSE 8880

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8880/health || exit 1

CMD ["python", "-m", "api.main"]
